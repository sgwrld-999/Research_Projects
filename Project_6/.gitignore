# Project_6: standard python & project ignores

# OS
.DS_Store
Thumbs.db
desktop.ini

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Virtual environments
venv/
env/
ENV/
.venv/

# Build / packaging
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Jupyter
.ipynb_checkpoints
*.ipynb

# Models & checkpoints
*.pth
*.pt
*.ckpt
models/
checkpoints/
!models/.gitkeep

# Logs, outputs, results
logs/
*.log
results/
outputs/
runs/
plots/

# Cache and testing
.cache/
.pytest_cache/
.coverage
htmlcov/
.tox/

# Data files (usually large)
data/
*.csv
*.npy
*.parquet

# Temporary/etl
etl_pipeline/temp/
*.tmp

# End of Project_6 .gitignore
